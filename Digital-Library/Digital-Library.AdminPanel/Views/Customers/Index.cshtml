@using Digital_Library.Core.ViewModels
@model IEnumerable<CustomerSummaryViewModel>
@{
    ViewData["Title"] = "Customer Management";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded h-100 p-4">
        <h6 class="mb-4">All Customers</h6>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Full Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Registration Date</th>
                        <th scope="col">Total Orders</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.FullName</td>
                            <td>@customer.Email</td>
                            <td>@customer.RegistrationDate.ToString("yyyy-MM-dd")</td>
                            <td>@customer.TotalOrders</td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Banned</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-info">Details</a>
                                <form asp-action="ToggleStatus" asp-route-id="@customer.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(customer.IsActive ? "btn-danger" : "btn-success")">
                                        @(customer.IsActive ? "Ban" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>