@model Digital_Library.Core.ViewModels.BookFormViewModel
@{
 ViewData["Title"] = "Edit Book";
}

<div class="container-fluid pt-4 px-4">
 <div class="bg-light rounded h-100 p-4">

  <form asp-action="Edit" method="post" enctype="multipart/form-data">
			<span asp-validation-summary="ModelOnly" class="text-danger"></span>
   <input type="hidden" asp-for="Id" />
   <input type="hidden" asp-for="ExistingCoverImage" />

   <div class="row">
    <div class="col-md-8">
     <div class="form-floating mb-3">
      <input asp-for="Title" class="form-control" placeholder="Book Title" />
      <label asp-for="Title"></label>
      <span asp-validation-for="Title" class="text-danger"></span>
     </div>
     <div class="form-floating mb-3">
      <input asp-for="Author" class="form-control" placeholder="Author" />
      <label asp-for="Author"></label>
      <span asp-validation-for="Author" class="text-danger"></span>
     </div>
     <div class="form-floating mb-3">
      <textarea asp-for="Description" class="form-control" placeholder="Description" style="height:150px;"></textarea>
      <label asp-for="Description"></label>
      <span asp-validation-for="Description" class="text-danger"></span>
     </div>
    </div>

    <div class="col-md-4">
     @if (!string.IsNullOrEmpty(Model.ExistingCoverImage))
     {
      <div class="mb-3">
       <img src="https://zzaki213-001-site1.stempurl.com/@Model.ExistingCoverImage"
            alt="Current Cover"
            class="img-thumbnail"
            style="max-height:200px;" />
      </div>
     }

     <!-- رفع صورة جديدة -->
     <div class="form-floating mb-3">
      <input type="file" name="CoverImage" class="form-control" />
      <label for="CoverImage">Change Cover</label>
     </div>

     <div class="form-floating mb-3">
      <input asp-for="PricePhysical" class="form-control" />
      <label asp-for="PricePhysical"></label>
      <span asp-validation-for="PricePhysical" class="text-danger"></span>
     </div>
     @if (Model.PricePdf!=0)
      {
      <div class="form-floating mb-3">
       <input asp-for="PricePdf" class="form-control" />
       <label asp-for="PricePdf"></label>
       <span asp-validation-for="PricePdf" class="text-danger"></span>
      </div>
      }

     <div class="form-floating mb-3">
      <select asp-for="CategoryId" class="form-select" asp-items="Model.Categories">
       <option value="">Select a Category</option>
      </select>
      <label asp-for="CategoryId"></label>
      <span asp-validation-for="CategoryId" class="text-danger"></span>
     </div>
     <div class="form-floating mb-3">
      <select asp-for="VendorId" class="form-select" asp-items="Model.Vendors">
       <option value="">Select a Vendor</option>
      </select>
      <label asp-for="VendorId"></label>
      <span asp-validation-for="VendorId" class="text-danger"></span>
     </div>
    </div>
   </div>

   <button type="submit" class="btn btn-primary">Update</button>
   <a asp-action="Index" class="btn btn-secondary">Cancel</a>
  </form>
 </div>
</div>
