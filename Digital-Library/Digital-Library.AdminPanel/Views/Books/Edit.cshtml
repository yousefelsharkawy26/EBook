@using Digital_Library.Core.ViewModels
@model BookFormViewModel
@{
	ViewData["Title"] = "Edit Book";
}

<div class="container-fluid pt-4 px-4">
	<form asp-controller="Books" asp-action="Edit" method="post" enctype="multipart/form-data">
		<div class="bg-light rounded h-100 p-4">
			<h6 class="mb-4">@ViewData["Title"]</h6>
			<partial name="Shared/_BookForm" model="Model" />
			<button type="submit" class="btn btn-primary">Update</button>
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>