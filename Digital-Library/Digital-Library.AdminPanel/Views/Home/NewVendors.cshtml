@using Digital_Library.Core.Enums
@model IEnumerable<Digital_Library.Core.Models.Vendor>

@{
    ViewData["Title"] = "NewVendors";
}
<div class="content">
    <div class="pt-4">
        <div class="row g-4">
            <div class="col-12">
                <div class="bg-light rounded h-100 p-2">
                    <h6 class="mb-4">Vendor Management</h6>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Vendor</th>
                                    <th scope="col">Library</th>
                                    <th scope="col">Location</th>
                                    <th scope="col">Contact</th>
                                    <th scope="col">Wallet</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Rejection Reason</th>
                                    <th scope="col">Submitted</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center">No pending vendor requests found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr id="vendor-row-@item.Id">
                                            <td>
                                                <div class="fw-bold">@item.User.FullName</div>
                                                <small class="text-muted">@item.User.Email</small>
                                            </td>
                                            <td>@item.LibraryName</td>
                                            <td>@item.City, @item.State</td>
                                            <td>@item.ContactNumber</td>
                                            <td>$@item.WalletBalance.ToString("N2")</td>
                                            <td>
                                                @{
                                                    var statusClass = item.Status switch
                                                    {
                                                        VendorStatus.Approved => "text-bg-success",
                                                        VendorStatus.Rejected => "text-bg-danger",
                                                        _ => "text-bg-warning"
                                                    };
                                                }
                                                <select class="form-select form-select-sm @statusClass"
                                                        data-vendor-id="@item.Id"
                                                        onchange="handleStatusChange(this)">
                                                    @foreach (var status in Enum.GetValues(typeof(VendorStatus)))
                                                    {
                                                        var statusValue = (VendorStatus)status;
                                                        <option value="@statusValue" selected="@(item.Status == statusValue)">
                                                            @statusValue.ToString()
                                                        </option>
                                                    }
                                                </select>
                                            </td>
                                            
                                            <td>@item.SubmittedAt.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // استخدمنا الطريقة الآمنة لتمرير الـ ID عبر data-attributes
        async function handleStatusChange(selectElement) {
            const vendorId = selectElement.dataset.vendorId;
            const newStatus = selectElement.value;

            console.log(`Vendor ID: ${vendorId}`);
            console.log(`New Status: ${newStatus}`);

            // نستخدم try...catch للتعامل مع الأخطاء
            try {
                // 1. انتظر (await) نتيجة الـ fetch
                const response = await fetch('/api/Vendors/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        vendorId: vendorId,
                        newStatus: newStatus
                    })
                });

                // 2. تحقق من نجاح الـ response
                if (response.ok) {
                    console.log("Status updated successfully!");
                    alert('Status updated successfully!');
                } else {
                    // إذا كان هناك خطأ من السيرفر (مثل 404 أو 500)
                    console.error("Failed to update status. Server responded with:", response.status);
                    alert(`Error: Could not update the status. (Status: ${response.status})`);
                }
            } catch (error) {
                // 3. هذا الـ catch يلتقط أخطاء الشبكة فقط (مثل فشل الاتصال)
                console.error('Network error:', error);
                alert('A network error occurred. Please try again.');
            }
        }
    </script>
}