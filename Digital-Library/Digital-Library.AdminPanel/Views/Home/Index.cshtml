@using Digital_Library.Core.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- =============================================================== -->
<!-- ======================= 1. KPI CARDS ========================== -->
<!-- =============================================================== -->
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <!-- Total Revenue Card -->
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-chart-line fa-3x text-primary"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2">Total Revenue</p>
                    <h6 class="mb-0">$@Model.TotalRevenue.ToString("N2")</h6>
                </div>
            </div>
        </div>
        <!-- New Users Today Card -->
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-user-plus fa-3x text-primary"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2">New Users Today</p>
                    <h6 class="mb-0">@Model.NewUsersToday</h6>
                </div>
            </div>
        </div>
        <!-- Pending Vendors Card -->
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-store fa-3x text-primary"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2">Pending Vendors</p>
                    <h6 class="mb-0">@Model.PendingVendorsCount</h6>
                </div>
            </div>
        </div>
        <!-- Total Books Card -->
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-book fa-3x text-primary"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2">Total Books</p>
                    <h6 class="mb-0">@Model.TotalBooksCount</h6>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =============================================================== -->
<!-- ======================= 2. CHARTS ============================= -->
<!-- =============================================================== -->
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <!-- User Growth Chart -->
        <div class="col-sm-12 col-xl-6">
            <div class="bg-light text-center rounded p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0">User Growth (Last 30 Days)</h6>
                </div>
                <canvas id="userGrowthChart"></canvas>
            </div>
        </div>
        <!-- Sales Performance Chart -->
        <div class="col-sm-12 col-xl-6">
            <div class="bg-light text-center rounded p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0">Sales Performance (Last 30 Days)</h6>
                </div>
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- =============================================================== -->
<!-- ======================= 3. RECENT ACTIVITY ==================== -->
<!-- =============================================================== -->
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <!-- Recent Sales Table -->
        <div class="col-sm-12 col-xl-6">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Recent Sales</h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Date</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Amount</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentSales.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No recent sales found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var sale in Model.RecentSales)
                                {
                                    <tr>
                                        <td>@sale.SaleDate.ToString("MMM dd, yyyy")</td>
                                        <td>@sale.CustomerName</td>
                                        <td>$@sale.Amount.ToString("N2")</td>
                                        <td>@sale.Status</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Pending Vendors Table -->
        <div class="col-sm-12 col-xl-6">
            <div class="bg-light rounded h-100 p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0">Pending Vendor Approvals</h6>
                    <a asp-action="NewVendors" asp-controller="Vendor">Show All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Vendor</th>
                                <th scope="col">Library</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingVendors.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No pending vendor requests.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vendor in Model.PendingVendors)
                                {
                                    <tr>
                                        <td>@vendor.VendorName</td>
                                        <td>@vendor.LibraryName</td>
                                        <td>
                                            <a asp-action="NewVendors" asp-controller="Vendor" class="btn btn-sm btn-primary">Review</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/lib/chart/chart.min.js"></script>
    <script>
        $(document).ready(function() {
            // Configuración global de los gráficos para que coincidan con el tema
            Chart.defaults.color = "#6C7293";
            Chart.defaults.borderColor = "rgba(0, 0, 0, 0.1)";

            /**
             * Función genérica para obtener datos de gráficos desde una API y renderizarlos.
             * param {string} url - La URL del endpoint de la API.
             * param {string} canvasId - El ID del elemento canvas.
             * param {string} chartType - El tipo de gráfico ('line', 'bar', etc.).
             * param {string} label - La etiqueta para el conjunto de datos.
             * param {boolean} fill - Si se debe rellenar el área bajo la línea (para gráficos de línea).
             */
            async function fetchAndRenderChart(url, canvasId, chartType, label, fill = false) {
                try {
                    const response = await fetch(url);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    const data = await response.json();

                    const ctx = document.getElementById(canvasId).getContext("2d");
                    new Chart(ctx, {
                        type: chartType,
                        data: {
                            labels: data.labels,
                            datasets: [{
                                label: label,
                                data: data.data,
                                backgroundColor: chartType === 'bar' ? "rgba(0, 156, 255, .7)" : "rgba(0, 156, 255, .3)",
                                borderColor: "rgba(0, 156, 255, .7)",
                                fill: fill
                            }]
                        },
                        options: {
                            responsive: true,
                            tension: chartType === 'line' ? 0.4 : 0, // Suavizar la línea solo para gráficos de línea
                            scales: {
                                y: {
                                    beginAtZero: true
                                }
                            }
                        }
                    });
                } catch (error) {
                    console.error(`Failed to load data for chart '${canvasId}':`, error);
                    // Opcional: mostrar un mensaje de error en lugar del gráfico
                    $(`#${canvasId}`).replaceWith('<p class="text-center text-danger">Could not load chart data.</p>');
                }
            }

            // Cargar los datos para cada gráfico al cargar la página
            fetchAndRenderChart('/api/Dashboard/GetUserGrowthChartData', 'userGrowthChart', 'line', 'New Users', true);
            fetchAndRenderChart('/api/Dashboard/GetSalesChartData', 'salesChart', 'bar', 'Daily Sales ($)');
        });
    </script>
}