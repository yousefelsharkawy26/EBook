                    label: 'Revenue',
                    data: [@Model.TotalRevenue],
                    backgroundColor: '#4a6cf7'
                }]
            },
            options: { scales: { y: { beginAtZero: true } } }
        });

        const booksCtx = document.getElementById('booksChart').getContext('2d');
        new Chart(booksCtx, {
            type: 'bar',
            data: {
                labels: ['This Month'],
                datasets: [{
                    label: 'Books Sold',
                    data: [@Model.TotalBooksSold],
                    backgroundColor: '#28a745'
                }]
            },
            options: { scales: { y: { beginAtZero: true } } }
        });
