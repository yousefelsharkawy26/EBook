<link rel="stylesheet" href="~/css/_SearchBarView.css" />

<div class="search-popup">
 <div class="search-popup-container">

  <!-- Search Form -->
  <form role="search" method="get" class="search-form"
        asp-controller="Book" asp-action="ViewAllBooks">
   <input type="search" id="search-form" class="search-field"
          placeholder="Type and press enter"
          name="query" />
   <button type="submit" class="search-submit">
    <svg class="search">
     <use xlink:href="#search"></use>
    </svg>
   </button>
  </form>

  <!-- Categories -->
  <h5 class="cat-list-title">Browse Categories</h5>
  <ul id="cat-list" class="cat-list">
   <!-- هيتعبّى بالـ JS -->
  </ul>
 </div>
</div>

<script>
 document.addEventListener("DOMContentLoaded", function () {
     fetch("/Home/GetCategories")
         .then(response => response.json())
         .then(data => {
             const list = document.getElementById("cat-list");
             list.innerHTML = "";

             data.forEach(category => {
                 const li = document.createElement("li");
                 li.classList.add("cat-list-item");

                 li.innerHTML = `
                     <a href="/Book/AllBooks?category=${category.id}">
                         ${category.name}
                     </a>
                 `;
                 list.appendChild(li);
             });
         })
         .catch(error => console.error("Error loading categories:", error));
 });
</script>
