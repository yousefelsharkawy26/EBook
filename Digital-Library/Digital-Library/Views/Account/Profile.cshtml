@using Digital_Library.Core.Models
@model User

@{
    var image = ((Model.ImageUrl != null) ? Model.ImageUrl : "images/avatar.png");
    var fullName = Model.FullName.Split(" ");

}

<style>
    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-primary:hover, .btn-primary:focus {
            background-color: #e85b60;
            border-color: #e85b60;
        }

    .btn-outline-secondary:hover, .btn-outline-secondary:focus {
        color: var(--white-color);
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }
</style>

<section class="padding-large">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="profile-card text-center">
                    <div class="mb-3">
                        <img id="profilePreview"
                             src="~/@image"
                             data-default-src="~/images/avatar.png"
                             alt="Profile picture of John Doe"
                             width="120" height="120"
                             style="object-fit: cover; border-radius: 50%; border: 4px solid var(--primary-color);" />
                    </div>
                    <h3 class="mb-0">@Model.FullName</h3>
                    <p class="mb-4">@Model.Email</p>

                    <form id="profileForm"
                          action="/profile"
                          method="post"
                          enctype="multipart/form-data"
                          autocomplete="on">
                        <div class="mb-3 text-start">
                            <label for="fullname" class="form-label">Full Name</label>
                            <input type="text"
                                   class="form-control"
                                   id="fullname"
                                   name="fullName"
                                   asp-for="FullName"
                                   placeholder="Enter full name"
                                   autocomplete="name"
                                   required>
                        </div>

                        <div class="mb-3 text-start">
                            <label for="email" class="form-label">Email</label>
                            <input type="email"
                                   class="form-control"
                                   id="email"
                                   name="email"
                                   asp-for="Email"
                                   placeholder="Enter email"
                                   autocomplete="email"
                                   readonly>
                        </div>

                        <div class="mb-2 text-start">
                            <label for="profileImage" class="form-label">Profile Image</label>
                            <input type="file"
                                   class="form-control"
                                   id="profileImage"
                                   name="profileImage"
                                   accept="image/jpeg,image/png,image/webp,image/gif">
                            <small id="imageHelp" class="form-text text-muted" aria-live="polite">
                                Upload JPG, PNG, WEBP, or GIF (max 2 MB).
                            </small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button id="submitBtn" type="submit" class="btn btn-primary btn-lg">
                                Update Profile
                            </button>
                            <button type="reset" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('profileForm');
      const submitBtn = document.getElementById('submitBtn');
      const fileInput = document.getElementById('profileImage');
      const img = document.getElementById('profilePreview');
      const imageHelp = document.getElementById('imageHelp');
      const nameInput = document.getElementById('fullname');

      // Update avatar alt text as the name changes
      const updateAlt = () => {
        const name = nameInput.value.trim() || 'your profile';
        img.alt = `Profile picture of ${name}`;
      };
      nameInput.addEventListener('input', updateAlt);
      updateAlt();

      // Image preview + validation
      fileInput.addEventListener('change', () => {
        imageHelp.classList.remove('text-danger');
        imageHelp.textContent = 'Upload JPG, PNG, WEBP, or GIF (max 2 MB).';

        const file = fileInput.files && fileInput.files[0];
        if (!file) return;

        const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
        const maxSize = 2 * 1024 * 1024; // 2MB

        if (!validTypes.includes(file.type)) {
          imageHelp.textContent = 'Please upload a JPEG, PNG, WEBP, or GIF image.';
          imageHelp.classList.add('text-danger');
          fileInput.value = '';
          return;
        }
        if (file.size > maxSize) {
          imageHelp.textContent = 'Image must be smaller than 2 MB.';
          imageHelp.classList.add('text-danger');
          fileInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = (e) => { img.src = e.target.result; };
        reader.readAsDataURL(file);
      });

      // Reset restores the original avatar preview and help text
      form.addEventListener('reset', () => {
        setTimeout(() => {
          img.src = img.dataset.defaultSrc;
          imageHelp.textContent = 'Upload JPG, PNG, WEBP, or GIF (max 2 MB).';
          imageHelp.classList.remove('text-danger');
        }, 0); // allow native reset to apply first
      });

      // Submit button spinner/disabled state
      form.addEventListener('submit', () => {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Updating...';
      });
    });
</script>