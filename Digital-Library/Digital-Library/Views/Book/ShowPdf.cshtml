@using Digital_Library.Core.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@{
 ViewData["Title"] = "View PDF";
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
}

<div class="container my-5">
 <h3 class="mb-4">📖 PDF Viewer</h3>

 @if (ViewBag.PdfPath != null)
 {
  <div class="ratio ratio-16x9 shadow-sm">
   <iframe src="~/@ViewBag.PdfPath" width="100%" height="600px" frameborder="0">
    This browser does not support PDFs.
    <a href="~/@ViewBag.PdfPath">Download PDF</a>.
   </iframe>
  </div>
 }
 else
 {
  <div class="alert alert-danger">PDF not found.</div>
 }
    @if (roles.Contains(Digital_Library.Core.Constant.Roles.Vendor))
    {
        <a asp-action="Index" asp-controller="Book" class="btn btn-secondary mt-3">Back to list Books</a>

        <a asp-action="ShowMyBook" asp-controller="Book" class="btn btn-secondary mt-3">Back to My Books</a>
    }
    else
    {
        <a asp-action="ShowMyBook" asp-controller="Book" class="btn btn-secondary mt-3">Back to My Books</a>
    }
</div>
