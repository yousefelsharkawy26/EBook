@using Digital_Library.Service.Implementation
@model IEnumerable<MyBookViewModel>

<h2>My Books</h2>

@if (!Model.Any())
{
    <div class="alert alert-dismissible alert-danger">
        <button type="button" class="btn-close" data-bs-dismiss="alert" fdprocessedid="gy7egc"></button>
        <h4 class="alert-heading">Warning!</h4>
        <p class="mb-0">You haven’t purchased or borrowed any books yet.</p>
        <a class="btn btn-primary" asp-controller="Book" asp-action="ViewAllBooks" >Shop</a>
    </div>

}
else
{
    <div class="row">
        @* <!-- Physical Books -->
    <div class="col-md-12 mb-5">
        <h3>📚 Physical Books</h3>
        <div class="row">
            @foreach (var item in Model.Where(m => m.FormatType == Digital_Library.Core.Enums.FormatType.Physical))
            {
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <img src="/@item.Book.ImageBookCoverPath" class="card-img-top" alt="@item.Book.Title" />
                        <div class="card-body">
                            <h5>@item.Book.Title</h5>
                            <p>@item.Book.Author</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div> *@
        @if ((Model.Where(m => m.FormatType == Digital_Library.Core.Enums.FormatType.PDF)).Any())
        {
            <!-- PDF Books -->
            <div class="col-md-12 mb-5">
            <h3>💻 PDF Books</h3>
            <div class="row">
                @foreach (var item in Model.Where(m => m.FormatType == Digital_Library.Core.Enums.FormatType.PDF))
                {
                    <div class="col-md-3 mb-3">
                        <div class="card">
                            <img src="/@item.Book.ImageBookCoverPath" class="card-img-top" alt="@item.Book.Title" />
                            <div class="card-body">
                                <h5>@item.Book.Title</h5>
                                <p>@item.Book.Author</p>
                                <a asp-controller="Book" asp-action="ShowPdf" asp-route-id="@item.Book.Id" class="btn btn-primary d-block">Open PDF</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
            
        }
        @if ((Model.Where(m => m.FormatType == Digital_Library.Core.Enums.FormatType.Borrowing)).Any())
        {
            <!-- Borrowed Books -->
            <div class="col-md-12 mb-5">
            <h3>📖 Borrowed Books</h3>
            <div class="row">
                @foreach (var item in Model.Where(m => m.FormatType == Digital_Library.Core.Enums.FormatType.Borrowing))
                {
                    <div class="col-md-3 mb-3">
                        <div class="card">
                            <img src="/@item.Book.ImageBookCoverPath" class="card-img-top" alt="@item.Book.Title" />
                            <div class="card-body">
                                <h5>@item.Book.Title</h5>
                                <p>@item.Book.Author</p>
                                @if (item.DueDate.HasValue && item.DueDate.Value >= DateTime.Now)
                                {
                                    <a asp-controller="Book" asp-action="ShowPdf" asp-route-id="@item.Book.Id" class="btn btn-primary d-block">Open PDF</a>
                                    <span class="badge @(((item.DueDate.Value - DateTime.Now).Days <= 2) ? "bg-danger" : "bg-success") w-100 text-center">
                                        @( (item.DueDate.Value - DateTime.Now).Days ) days left
                                    </span>

                                }
                                else
                                {
                                    <span class="badge bg-danger d-block text-center">Borrow expired</span>
                                }

                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>  
        }
    </div>
}