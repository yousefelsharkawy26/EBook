@using Azure.Core
@using Digital_Library.Service.Interface
@model IEnumerable<Digital_Library.Core.Models.Book>
@inject IFileService _fileService

@{
    ViewData["Title"] = "ViewAllBooks";
    var url = Url.Content("~/images/banner-image-bg-1.jpg");
    var currentSort = Context.Request.Query["sort"].ToString();
    var currentCategory = Context.Request.Query["category"].ToString();
    var currentAuthor = Context.Request.Query["author"].ToString();
    var currentPrice = Context.Request.Query["priceRange"].ToString();
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalItems = ViewBag.TotalItems as int? ?? 0;

    
    int maxPagesToShow = 5;
    var pageSize = ViewBag.PageSize as int? ?? 8;

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

    if (endPage - startPage + 1 < maxPagesToShow && startPage > 1)
    {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
    
    
    

    var startItem = ((currentPage - 1) * pageSize) + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);
}

<style>
    .book-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: linear-gradient(to bottom, #ffffff, #f8f9fa);
    }

        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
        }

    .book-cover-wrapper {
        height: 200px;
        overflow: hidden;
        background: linear-gradient(45deg, #f8f9fa, #e9ecef);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .book-cover-wrapper img {
            max-height: 100%;
            width: auto;
            transition: transform 0.3s ease;
        }

    .book-card:hover .book-cover-wrapper img {
        transform: scale(1.05);
    }

    .card-title a:hover {
        color: #0d6efd !important;
    }

    .pricing-section {
        background-color: rgba(13, 110, 253, 0.05);
        border-radius: 12px;
        padding: 10px;
    }

    .price-item:not(:last-child) {
        margin-bottom: 5px;
    }

    .rating i {
        font-size: 0.8rem;
    }

    .z-index-2 {
        z-index: 2;
    }
    /* Modern Pagination Styling */
    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
    }

        .pagination .page-link {
            border: none;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 0.95rem;
            font-weight: 500;
            color: #0d6efd;
            background-color: #f8f9fa;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
            transition: all 0.25s ease;
        }

            .pagination .page-link:hover {
                background-color: #0d6efd;
                color: #fff;
            }

        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            color: #fff;
            font-weight: 600;
            box-shadow: 0 3px 8px rgba(13, 110, 253, 0.3);
        }

        .pagination .page-item.disabled .page-link {
            background-color: #e9ecef;
            color: #adb5bd;
            box-shadow: none;
            pointer-events: none;
        }

</style>


<section class="hero-section position-relative padding-large" style="background-image: url(@url) ;background-size: cover; background-repeat: no-repeat; background-position: center; height: 400px;">
    <div class="hero-content">
        <div class="container">
            <div class="row">
                <div class="text-center">
                    <h1>Shop</h1>
                    <div class="breadcrumbs">
                        <span class="item">
                            <a asp-controller="Home" asp-action="Index">Home > </a>
                        </span>
                        <span class="item text-decoration-underline">Shop</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="shopify-grid padding-large">
    <div class="container">
        <div class="row flex-row-reverse g-md-5">
            <main class="col-md-9">
                <div class="filter-shop d-flex flex-wrap justify-content-between mb-5">
                    <div class="showing-product">
                        <p>Showing @startItem–@endItem of @totalItems results</p>

                    </div>
                    <div class="sort-by">
                        <form method="get" id="sortForm">
                            <select id="sorting" name="sort" class="form-select" onchange="document.getElementById('sortForm').submit();">
                                <option value="">Default sorting</option>

                                @if (Context.Request.Query["sort"] == "NameAsc")
                                {
                                    <option value="NameAsc" selected>Name (A - Z)</option>
                                }
                                else
                                {
                                    <option value="NameAsc">Name (A - Z)</option>
                                }

                                @if (Context.Request.Query["sort"] == "NameDesc")
                                {
                                    <option value="NameDesc" selected>Name (Z - A)</option>
                                }
                                else
                                {
                                    <option value="NameDesc">Name (Z - A)</option>
                                }

                                @if (Context.Request.Query["sort"] == "PriceLowHigh")
                                {
                                    <option value="PriceLowHigh" selected>Price (Low-High)</option>
                                }
                                else
                                {
                                    <option value="PriceLowHigh">Price (Low-High)</option>
                                }

                                @if (Context.Request.Query["sort"] == "PriceHighLow")
                                {
                                    <option value="PriceHighLow" selected>Price (High-Low)</option>
                                }
                                else
                                {
                                    <option value="PriceHighLow">Price (High-Low)</option>
                                }

                                @if (Context.Request.Query["sort"] == "RatingHigh")
                                {
                                    <option value="RatingHigh" selected>Rating (Highest)</option>
                                }
                                else
                                {
                                    <option value="RatingHigh">Rating (Highest)</option>
                                }

                                @if (Context.Request.Query["sort"] == "RatingLow")
                                {
                                    <option value="RatingLow" selected>Rating (Lowest)</option>
                                }
                                else
                                {
                                    <option value="RatingLow">Rating (Lowest)</option>
                                }

                            </select>
                        </form>
                    </div>


                </div>
                <div class="row product-content product-store g-4">
                    @foreach (var book in Model)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="card border-0 shadow-sm h-100 position-relative rounded-4 overflow-hidden book-card">
                                <div class="book-cover-wrapper">
                                    <img src="~/@book.ImageBookCoverPath"
                                         class="card-img-top object-fit-cover"
                                         alt="@book.Title">
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title fw-bold text-truncate mb-1">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="stretched-link text-dark text-decoration-none">
                                            @book.Title
                                        </a>
                                    </h6>
                                    <p class="text-info mb-2 small">@book.Author</p>

                                    <!-- Rating (still static as before) -->
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rating text-warning me-2">
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                        </div>
                                        <small class="text-info">(5)</small>
                                    </div>

                                    <!-- Pricing -->
                                    <div class="pricing-section mb-3">
                                        <div class="price-item d-flex justify-content-between">
                                            <span class="text-info small">Physical:</span>
                                            <span class="fw-bold text-primary">$@book.PricePhysical</span>
                                        </div>
                                        <div class="price-item d-flex justify-content-between">
                                            <span class="text-info small">PDF:</span>
                                            <span class="fw-bold text-primary">$@(book.PricePdf ?? 0)</span>
                                        </div>
                                        <div class="price-item d-flex justify-content-between">
                                            <span class="text-info small">Per Day:</span>
                                            <span class="fw-bold text-primary">$@(book.PricePDFPerDay ?? 0)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center pagination-lg">
                        <!-- Previous button -->
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link d-flex align-items-center justify-content-center"
                               asp-action="ViewAllBooks"
                               asp-route-page="@(ViewBag.CurrentPage - 1)">
                                «
                            </a>
                        </li>

                        

                        <!-- First page + dots -->
                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="ViewAllBooks" asp-route-page="1">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        <!-- Page numbers -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="ViewAllBooks" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <!-- Last page + dots -->
                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="ViewAllBooks" asp-route-page="@totalPages">@totalPages</a>
                            </li>
                        }

                        <!-- Next button -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link d-flex align-items-center justify-content-center"
                               asp-action="ViewAllBooks"
                               asp-route-page="@(currentPage + 1)">
                                »
                            </a>
                        </li>
                    </ul>
                </nav>


            </main>
            <aside class="col-md-3">
                <div class="sidebar ps-lg-5">
                    <div class="widget-menu">
                        <div class="widget-search-bar">
                            <form class="d-flex border rounded-3 p-2" role="search">
                                <input class="form-control border-0 me-2 py-2" type="search" placeholder="Search" aria-label="Search">
                                <button class="btn rounded-3 p-3 d-flex align-items-center" type="submit">
                                    <svg class="search text-light" width="18" height="18">
                                        <use xlink:href="#search"></use>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="widget-product-categories pt-5">
                        <div class="section-title overflow-hidden mb-2">
                            <h3 class="d-flex flex-column mb-0">Categories</h3>
                        </div>
                        <ul class="product-categories mb-0 sidebar-list list-unstyled">
                            <li class="cat-item">
                                <a href="/Book/allbooks">All</a>
                            </li>
                            @foreach (var category in ViewBag.Categories as IEnumerable<Digital_Library.Core.Models.Category>)
                            {
                                <li class="cat-item">
                                    <a href="/Book/allbooks?category=@category.Id">@category.CategoryName</a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="widget-product-authur pt-5">
                        <div class="section-title overflow-hidden mb-2">
                            <h3 class="d-flex flex-column mb-0">Authors</h3>
                        </div>
                        <ul class="product-tags mb-0 sidebar-list list-unstyled">
                            @foreach (var author in ViewBag.Authors as IEnumerable<string>)
                            {
                                <li class="tags-item">
                                    <a href="/Book/allbooks?author=@author">@author</a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="widget-price-filter pt-5">
                        <div class="section-title overflow-hidden mb-2">
                            <h3 class="d-flex flex-column mb-0">Filter by price</h3>
                        </div>
                        <ul class="product-tags mb-0 sidebar-list list-unstyled">
                            <li class="tags-item">
                                <a href="/Book/allbooks?priceRange=0-10">Less than $10</a>
                            </li>
                            <li class="tags-item">
                                <a href="/Book/allbooks?priceRange=10-20">$10 - $20</a>
                            </li>
                            <li class="tags-item">
                                <a href="/Book/allbooks?priceRange=20-30">$20 - $30</a>
                            </li>
                            <li class="tags-item">
                                <a href="/Book/allbooks?priceRange=30-40">$30 - $40</a>
                            </li>
                            <li class="tags-item">
                                <a href="/Book/allbooks?priceRange=40-50">$40 - $50</a>
                            </li>
                        </ul>
                    </div>

                </div>
            </aside>
        </div>
    </div>
</div>

