@using Digital_Library.Core.Enums
@using Digital_Library.Core.ViewModels.Requests
@model PlaceOrderRequest


<div class="payment-section mt-5">
	<h3 class="mb-3">💳 Payment Information</h3>

	<form asp-action="PlaceOrder" asp-controller="Orders" method="post" class="payment-form">
		@Html.AntiForgeryToken()

		<div class="mb-3">
			<label asp-for="Address" class="form-label fw-bold">Shipping Address</label>
			<input type="text" asp-for="Address" class="form-control" id="Address" name="Address" required />
			<span asp-validation-for="Address" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
			<input type="tel" class="form-control" asp-for="PhoneNumber" id="PhoneNumber" name="PhoneNumber" required />
			<span asp-validation-for="PhoneNumber" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="PaymentMethod" class="form-label fw-bold">Select Payment Method</label>
			<select asp-for="PaymentMethod" class="form-select" id="PaymentMethod" name="PaymentMethod" required asp-items="Html.GetEnumSelectList<PaymentMethod>()">
				<option value=""  >-- Choose Method --</option>
			</select>
		</div>

		<div id="card-info" style="display:none;">
			<div class="mb-3">
				<label for="CardNumber" class="form-label fw-bold">Card Number</label>
				<input type="text" class="form-control" id="CardNumber" name="CardNumber" maxlength="16" placeholder="1234 5678 9012 3456">
			</div>

			<div class="row">
				<div class="col-md-6 mb-3">
					<label for="ExpiryDate" class="form-label fw-bold">Expiry Date</label>
					<input type="month" class="form-control" id="ExpiryDate" name="ExpiryDate">
				</div>
				<div class="col-md-6 mb-3">
					<label for="CVV" class="form-label fw-bold">CVV</label>
					<input type="password" class="form-control" id="CVV" name="CVV" maxlength="4" placeholder="123">
				</div>
			</div>
		</div>

		<button type="submit" class="checkout-btn w-100 mt-3">Complete Payment</button>
	</form>
</div>