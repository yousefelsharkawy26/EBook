<Window x:Class="Digital_Library.PdfViewer.PdfViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Digital_Library.PdfViewer.Controls"
        Title="PdfViewerWindow" Height="700" Width="1000"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

	<Grid x:Name="MainGrid">
		<DockPanel>
			<!-- Toolbar -->
			<ToolBar x:Name="PdfToolBar" DockPanel.Dock="Top">
				<Button Content="Prev" Click="Prev_Click"/>
				<Button Content="Next" Click="Next_Click"/>
				<Button Content="Save" Click="Save_Click"/>
				<Button Content="Print" Click="Print_Click"/>
				<Separator/>
				<Button Content="✏️ Pencil" Click="Pencil_Click"/>
				<Button Content="🖍️ Highlight" Click="Highlight_Click"/>
				<Button Content="🔤 Text" Click="Text_Click"/>
				<Button Content="🧽 Erase" Click="Erase_Click"/>
				<Button Content="❌ Clear Page" Click="Clear_Click"/>
				<Button Content="🔲 Select" Click="Select_Click"/>
				<Separator/>
				<Button Content="➕ Zoom In" Click="ZoomIn_Click"/>
				<Button Content="➖ Zoom Out" Click="ZoomOut_Click"/>
				<Separator/>
				<TextBox x:Name="SearchBox" Width="80" KeyDown="SearchBox_KeyDown"/>
				<TextBlock x:Name="PageInfo" Margin="10,0,0,0" VerticalAlignment="Center"/>
			</ToolBar>

			<!-- PDF Viewer -->
			<local:CustomPdfViewer x:Name="PdfRenderer"/>
		</DockPanel>
	</Grid>
</Window>
	
