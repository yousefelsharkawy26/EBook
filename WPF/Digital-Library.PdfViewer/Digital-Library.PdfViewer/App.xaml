<Application x:Class="Digital_Library.PdfViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Digital_Library.PdfViewer" 
             xmlns:viewModels="clr-namespace:Digital_Library.PdfViewer.ViewModels"
             xmlns:views="clr-namespace:Digital_Library.PdfViewer.Views" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- App.xaml -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
